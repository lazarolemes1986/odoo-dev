<odoo>
  <record id="view_mi_categoria_list" model="ir.ui.view">
         <field name="name">mi.categoria.list</field>
         <field name="model">mi.categoria</field>
         <field name="arch" type="xml">
               <tree>
                    <field name="name"></field>
               </tree>
        </field>
  </record>
  <record id="view_mi_categoria_form" model="ir.ui.view">
        <field name="name">mi.categoria.form</field>
        <field name="model">mi.categoria</field>
        <field name="arch" type="xml">
            <form string="Categoria">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcion"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="producto_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="precio"/>
                                    <field name="stock"/>
                                    <field name="valor_total" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
  </record>
 
  <record id="view_mi_categoria_search" model="ir.ui.view">
        <field name="name">mi.categoria.search</field>
        <field name="model">mi.categoria</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archivadas"
                        name="archivadas"
                        domain="[('active', '=', False)]"
                        context="{'active_test':False}"/>

                <filter string="Con productos"
                        name="con_productos"
                        domain="[('producto_ids', '!=', False)]"/>

                <filter string="Sin productos"
                        name="sin_productos"
                        domain="[('producto_ids', '=', False)]"/>
            </search>
        </field>
  </record>

  <record id="action_mi_categoria" model="ir.actions.act_window">
        <field name="name">Categorias</field>
        <field name="res_model">mi.categoria</field>
        <field name="view_mode">tree,form</field>
  </record>
   <menuitem
        id="menu_mi_categoria"
        name="Categorias"
        parent="menu_mi_producto_root"
        action="action_mi_categoria"
     
    />

</odoo>
